# Acrescente SOMENTE os parametros de banco ao .env existente.
# Preserve SECRET_KEY, configuracao de e-mail e demais variaveis do projeto.
# Nunca versione valores reais e nunca use prefixo EXPO_PUBLIC_ para estes dados.

# Formato principal: mysql://usuario:senha_codificada@host:porta/banco
# Tambem aceita mysql+pymysql://. Senha com @, #, :, / ou % exige codificacao URL.
# DATABASE_URL preenchida prevalece sobre DB_HOST/PORT/USER/PASSWORD/NAME.
DATABASE_URL=

# Alternativa quando DATABASE_URL estiver vazia: preencher TODOS os cinco campos.
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# CA especifica do provedor, se exigida. Caminho local para um arquivo PEM.
# Sem DB_SSL_CA, usa as CAs confiaveis do sistema. TLS permanece verificado.
DB_SSL_CA=