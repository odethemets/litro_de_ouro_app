# Acrescentar ao .env existente do BACKEND. Nao alterar o frontend.
# A DATABASE_URL ativa da aplicacao pode continuar apontando para Aiven.
# Usuarios/senhas abaixo sao apenas campos a preencher localmente.

DATABASE_URL_ORIGEM=
DB_SSL_CA_ORIGEM=C:/litro_de_ouro/back_end/certs/ca.pem

# Formato: mysql://USUARIO:SENHA_CODIFICADA@HOST:4000/litro_de_ouro_ensaio
DATABASE_URL_DESTINO=

# Normalmente vazia para usar a cadeia publica confiavel do sistema.
# Nao reutilizar automaticamente a CA privada da Aiven no TiDB.
DB_SSL_CA_DESTINO=